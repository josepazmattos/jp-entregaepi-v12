{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Private facial signature resources. Does not enable the application or create Organizations.",
  "Parameters": {
    "QuotaTable": {
      "Type": "String",
      "Default": "jp-entregaepi-facial-pilot-Data-17JO1YALF41ST"
    }
  },
  "Resources": {
    "Images": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        }
      }
    },
    "ImagesPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "Images"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Images",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${Images.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "AttestationKey": {
      "Type": "AWS::KMS::Key",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": "EntregaEPI facial evidence seal, independent of employer A1",
        "KeySpec": "ECC_NIST_P256",
        "KeyUsage": "SIGN_VERIFY",
        "KeyPolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "EnableAccountIAM",
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:root"
                }
              },
              "Action": "kms:*",
              "Resource": "*"
            }
          ]
        }
      }
    },
    "StreamRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/jp-entregaepi-v12-lambda-role"
                }
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "OnlyStream",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "rekognition:StartFaceLivenessSession",
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": "sa-east-1"
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "ApiPermissions": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "Roles": [
          "jp-entregaepi-v12-lambda-role"
        ],
        "PolicyName": "EntregaEPIFacialSignature",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "rekognition:CreateFaceLivenessSession",
                "rekognition:GetFaceLivenessSessionResults",
                "rekognition:DetectFaces",
                "rekognition:CompareFaces"
              ],
              "Resource": "*",
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": "sa-east-1"
                }
              }
            },
            {
              "Effect": "Allow",
              "Action": "sts:AssumeRole",
              "Resource": {
                "Fn::GetAtt": [
                  "StreamRole",
                  "Arn"
                ]
              }
            },
            {
              "Effect": "Allow",
              "Action": "kms:Sign",
              "Resource": {
                "Fn::GetAtt": [
                  "AttestationKey",
                  "Arn"
                ]
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "s3:PutObject",
                "s3:GetObjectVersion",
                "s3:DeleteObjectVersion"
              ],
              "Resource": {
                "Fn::Sub": "${Images.Arn}/private/*"
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "dynamodb:GetItem",
                "dynamodb:PutItem",
                "dynamodb:UpdateItem"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${QuotaTable}"
              },
              "Condition": {
                "ForAllValues:StringLike": {
                  "dynamodb:LeadingKeys": [
                    "LIMIT",
                    "LIMIT#*",
                    "INTEGRATED#*"
                  ]
                }
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "Bucket": {
      "Value": {
        "Ref": "Images"
      }
    },
    "AttestationKeyArn": {
      "Value": {
        "Fn::GetAtt": [
          "AttestationKey",
          "Arn"
        ]
      }
    },
    "StreamRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "StreamRole",
          "Arn"
        ]
      }
    }
  }
}
