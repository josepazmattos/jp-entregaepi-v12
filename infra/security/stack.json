    "AlertsLog": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/jp-entregaepi-security-alerts",
        "RetentionInDays": 90
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "AlertsFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "jp-entregaepi-security-alerts",
        "Runtime": "nodejs22.x",
        "Architectures": [
          "x86_64"
        ],
        "Handler": "src/security/alert-handler.handler",
        "MemorySize": 256,
        "Timeout": 20,
        "ReservedConcurrentExecutions": 2,
        "Role": {
          "Fn::GetAtt": [
            "AlertRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "ArtifactKey"
          }
        },
        "Environment": {
          "Variables": {
            "COGNITO_USER_POOL_ID": {
              "Ref": "UserPoolId"
            },
            "COGNITO_CLIENT_ID": {
              "Ref": "ClientId"
            },
            "SECURITY_TABLE": {
              "Ref": "SecurityTable"
            },
            "TABLE_NAME": {
              "Ref": "OperationalTable"
            },
            "JPGED_TABLE": {
              "Ref": "GedTable"
            },
            "JPGED_BUCKET": {
              "Ref": "DocumentsBucket"
            },
            "SIGNER_ROLE_ARN": {
              "Fn::GetAtt": [
