                    "Fn::Sub": "arn:aws:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${GedTable}"
                  },
                  {
                    "Fn::GetAtt": [
                      "SecurityTable",
                      "Arn"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "DependsOn": [
        "AuditBucketPolicy"
      ]
